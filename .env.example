# =====================================
# CarePolicy AI
# Environment Configuration
# =====================================
#
# Copy this file to `.env` and replace every placeholder
# with real values. Never commit `.env` to version control.

# -------------------------------------
# Application
# -------------------------------------
# Runtime environment: development | production
NODE_ENV=development

# Port the Express server listens on
PORT=5000

# -------------------------------------
# MongoDB Atlas
# -------------------------------------
# Full connection string for your MongoDB Atlas cluster
# (found in Atlas Dashboard -> Connect -> Drivers)
MONGODB_URI=<YOUR_MONGODB_ATLAS_CONNECTION_STRING>

# -------------------------------------
# Google Gemini
# -------------------------------------
# Which AI provider the LlmService uses. Currently only "gemini" is supported.
AI_PROVIDER=gemini

# API key for Google Gemini (used for AI policy analysis)
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# Gemini model to use for analysis
GEMINI_MODEL=gemini-flash-latest

# -------------------------------------
# Frontend
# -------------------------------------
# URL of the frontend application (used for CORS configuration)
FRONTEND_URL=http://localhost:3000

# -------------------------------------
# Logging
# -------------------------------------
# Minimum log level: debug | info | warn | error
LOG_LEVEL=info
