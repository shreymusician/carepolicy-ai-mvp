{
  "name": "myinsurance",
  "version": "0.1.0",
  "description": "MyInsurance — mobile-first insurance assistance for insurance coordinators",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "ts-node src/app.ts",
    "type-check": "tsc --noEmit",
    "test": "node --test -r ts-node/register src/services/__tests__/PromptBuilderService.test.ts",
    "seed:insurance": "ts-node scripts/seedInsurance.ts",
    "seed:demo": "ts-node scripts/seedDemo.ts",
    "import:irdai": "ts-node scripts/importIrdai.ts",
    "build:knowledge": "ts-node scripts/buildKnowledge.ts"
  },
  "keywords": [
    "healthcare",
    "insurance",
    "ai",
    "copilot"
  ],
  "author": "MyInsurance Team",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "sharp": "^0.35.3",
    "tesseract.js": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.20",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.8.0",
    "@types/pdf-parse": "^1.1.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
